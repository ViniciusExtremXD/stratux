---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import CredibilityBar from '~/components/CredibilityBar.astro';
import ProfileServices from '~/components/ProfileServices.astro';
import TaxCalculator from '~/components/TaxCalculator.astro';
import Process from '~/components/Process.astro';
import ObligationsCalendar from '~/components/ObligationsCalendar.astro';
import About from '~/components/About.astro';
import SocialProof from '~/components/SocialProof.astro';
import Diagnostic from '~/components/Diagnostic.astro';
import RegionsMap from '~/components/RegionsMap.astro';
