---
import Icon from '~/components/Icon.astro';
import { regions, legal, wa } from '~/data/site';

/**
 * Mapa de atendimento — Google Maps real, uma praça por vez.
 *
 * Única exceção do site à regra de "zero requisição de terceiro": o cliente
 * pediu localização de verdade, não um esquema desenhado. O documento
 * principal não carrega nenhum script de terceiro por causa disso — é só um
 * <iframe> apontando para o mapa, sem chave de API (embed público do Google).
 *
 * Troca de praça sem JavaScript: radios reais + :has(), mesmo padrão do
 * resto do site. Os quatro mapas ficam empilhados na mesma célula do grid;
 * a troca de opacidade é só CSS, então a "animação de alternar" funciona
 * mesmo se o motor de movimento nunca subir — e é neutralizada de verdade
 * pela regra global de html.motion-reduced (que já reduz toda transição).
 */

const addr = legal.address;

const mapSrc = (q: string) => `https://www.google.com/maps?q=${encodeURIComponent(q)}&output=embed`;

const waRegiao = wa(
  'Olá! Vim pelo site da Stratux e gostaria de saber como funciona o atendimento na minha região.',
);
---

<section class="regioes section" id="atendimento" aria-labelledby="atendimento-h">
  <div class="regioes__gate">
    {/* controles reais: sem JS a primeira praça continua visível */}
    <fieldset class="regioes__inputs sr-only">
      <legend>Escolha a praça no mapa</legend>
      {
        regions.map((r, i) => (
          <input type="radio" name="regiao" id={`regiao-${r.id}`} value={r.id} checked={i === 0} />
        ))
      }
    </fieldset>

    <div class="shell">
      <div class="sechead">
        <p class="kicker" data-reveal="fade">Atendimento</p>
        <h2 class="h2" id="atendimento-h" data-split>
          Quatro praças no estado de São Paulo.
        </h2>
        <p class="lead" data-reveal style="--i:1">
          Clique numa praça para ver o mapa. O trabalho todo roda online — clientes de qualquer
          cidade do país são atendidos normalmente.
        </p>
      </div>

      <div class="regioes__body">
        <div class="mapa card" data-reveal="scale">
          <div class="mapa__stage">
            {
              regions.map((r) => (
                <iframe
                  class="mapa__frame"
                  data-mapa={r.id}
                  src={mapSrc(r.mapQuery)}
                  title={`Mapa de localização — ${r.city}`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                />
              ))
            }
          </div>

          <figcaption class="mapa__cap">
            {
              regions.map((r) => (
                <span class="mapa__capitem" data-mapa-cap={r.id}>
                  {r.detail} · {r.city}/SP
                </span>
              ))
            }
          </figcaption>
        </div>

        <ul class="pracas" role="tablist" aria-label="Praças de atendimento">
          {
            regions.map((r, i) => (
              <li>
                <label
                  class="praca card card--hover"
                  for={`regiao-${r.id}`}
                  data-reveal
                  style={`--i:${i % 2}`}
                >
                  <span class="card__rule" aria-hidden="true" />

                  <div class="praca__head">
                    <h3 class="h4 praca__city">{r.city}</h3>
                    <span class:list={['badge', { 'badge--gold': r.role === 'Matriz' }]}>
                      {r.role}
                    </span>
                  </div>

                  <p class="praca__covers">
                    <span class="praca__lbl">Cobre</span>
                    <span>{r.covers}</span>
                  </p>

                  <p class="praca__detail">{r.detail}</p>

                  <span class="praca__go">
                    <Icon name="pin" size={14} />
                    <span>Ver no mapa</span>
                  </span>
                </label>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="regioes__foot" data-reveal>
        <div class="cluster regioes__cta">
          <a class="btn btn--gold magnetic" href={waRegiao} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={18} class="btn__ico" />
            <span>Falar sobre atendimento na minha região</span>
          </a>
          <a class="btn btn--ghost" href="#servicos">
            <span>Ver os serviços</span>
            <Icon name="arrowUpRight" size={16} class="btn__ico" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------- base */
  .regioes__body {
    display: grid;
    gap: clamp(1.75rem, 1rem + 3vw, 3rem);
    align-items: start;
  }

  /* ------------------------------------------------------------- mapa */
  .mapa {
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    height: 100%;
  }
  .mapa__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--bone-dim);
    flex: 1 1 auto;
    min-height: 380px;
  }
  .mapa__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--d-4) var(--e-soft);
  }
  .mapa__cap {
    flex: none;
    padding: var(--s-3) var(--s-4);
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--fg-mute);
    border-top: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .mapa__capitem {
    display: none;
  }

  /* ---------------------------------------------------------- lista de praças */
  .pracas {
    display: grid;
    gap: clamp(0.5rem, 0.4rem + 0.3vw, 0.75rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .praca {
    display: grid;
    gap: 0.35rem;
    padding: clamp(0.75rem, 0.65rem + 0.3vw, 1rem) clamp(0.9rem, 0.8rem + 0.4vw, 1.25rem);
    align-content: center;
    cursor: pointer;
    border-radius: var(--r-2);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    transition:
      border-color var(--d-2) var(--e-out),
      box-shadow var(--d-3) var(--e-out),
      transform var(--d-3) var(--e-out),
      background var(--d-2) var(--e-out);
  }
  .praca__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
  }
  .praca__city {
    margin: 0;
    font-size: clamp(1.05rem, 0.98rem + 0.2vw, 1.2rem);
    font-weight: 600;
  }
  .praca__lbl {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .praca__covers {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    line-height: 1.4;
    margin: 0;
  }
  .praca__detail {
    font-size: var(--fs-xs);
    color: var(--fg-mute);
    line-height: 1.45;
    margin: 0;
  }
  .praca__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg-mute);
    transition: color var(--d-2) var(--e-out);
  }
  .praca__go :global(svg) {
    color: var(--accent);
  }
  .praca:hover .praca__go {
    color: var(--fg);
  }

  /* estado ativo — a praça cujo mapa está visível */
  .praca:hover {
    border-color: var(--line-strong);
    box-shadow: var(--sh-1);
    transform: translateY(-1px);
  }

  /* --------------------------------------------------------------- rodapé */
  .regioes__foot {
    display: grid;
    margin-top: clamp(1.75rem, 1rem + 2.4vw, 2.75rem);
    padding-top: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
    border-top: 1px solid var(--line);
  }
  .regioes__cta {
    gap: var(--s-4);
  }

  /* ---------------------------------------------------- troca de praça
     Puramente CSS: cada input marcado revela o iframe e a legenda com o
     mesmo data-mapa, destaca o card correspondente e esconde os demais
     mapas atrás dele (pointer-events: none evita cliques fantasmas). A
     transição de opacidade é a "animação de alternar" pedida — some com
     html.motion-reduced pela regra global do design system. */
  .regioes__gate:has(#regiao-sp:checked) [data-mapa='sp'],
  .regioes__gate:has(#regiao-osasco:checked) [data-mapa='osasco'],
  .regioes__gate:has(#regiao-jundiai:checked) [data-mapa='jundiai'],
  .regioes__gate:has(#regiao-sorocaba:checked) [data-mapa='sorocaba'] {
    opacity: 1;
    pointer-events: auto;
  }
  .regioes__gate:has(#regiao-sp:checked) [data-mapa-cap='sp'],
  .regioes__gate:has(#regiao-osasco:checked) [data-mapa-cap='osasco'],
  .regioes__gate:has(#regiao-jundiai:checked) [data-mapa-cap='jundiai'],
  .regioes__gate:has(#regiao-sorocaba:checked) [data-mapa-cap='sorocaba'] {
    display: block;
  }
  .regioes__gate:has(#regiao-sp:checked) .praca[for='regiao-sp'],
  .regioes__gate:has(#regiao-osasco:checked) .praca[for='regiao-osasco'],
  .regioes__gate:has(#regiao-jundiai:checked) .praca[for='regiao-jundiai'],
  .regioes__gate:has(#regiao-sorocaba:checked) .praca[for='regiao-sorocaba'] {
    border-color: var(--accent);
    box-shadow: var(--sh-2);
    background: color-mix(in srgb, var(--accent) 3%, var(--bg-raised));
  }
  .regioes__gate:has(#regiao-sp:checked) .praca[for='regiao-sp'] .card__rule,
  .regioes__gate:has(#regiao-osasco:checked) .praca[for='regiao-osasco'] .card__rule,
  .regioes__gate:has(#regiao-jundiai:checked) .praca[for='regiao-jundiai'] .card__rule,
  .regioes__gate:has(#regiao-sorocaba:checked) .praca[for='regiao-sorocaba'] .card__rule {
    opacity: 1;
  }
  .regioes__gate:has(#regiao-sp:checked) .praca[for='regiao-sp'] .praca__go,
  .regioes__gate:has(#regiao-osasco:checked) .praca[for='regiao-osasco'] .praca__go,
  .regioes__gate:has(#regiao-jundiai:checked) .praca[for='regiao-jundiai'] .praca__go,
  .regioes__gate:has(#regiao-sorocaba:checked) .praca[for='regiao-sorocaba'] .praca__go {
    color: var(--accent);
  }

  /* foco por teclado chega ao card correspondente */
  .regioes__gate:has(#regiao-sp:focus-visible) .praca[for='regiao-sp'],
  .regioes__gate:has(#regiao-osasco:focus-visible) .praca[for='regiao-osasco'],
  .regioes__gate:has(#regiao-jundiai:focus-visible) .praca[for='regiao-jundiai'],
  .regioes__gate:has(#regiao-sorocaba:focus-visible) .praca[for='regiao-sorocaba'] {
    outline: 2px solid var(--gold-600);
    outline-offset: 3px;
  }

  /* ------------------------------------------------------------ respostas */
  @media (min-width: 640px) {
    .pracas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 980px) {
    .regioes__body {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 1rem + 3vw, 3.25rem);
      align-items: stretch;
    }
    .pracas {
      grid-template-columns: minmax(0, 1fr);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
    }
    .pracas > li {
      flex: 1 1 0;
      display: flex;
    }
    .praca {
      width: 100%;
      height: 100%;
    }
    .mapa {
      height: 100%;
      min-height: 100%;
    }
    .mapa__stage {
      aspect-ratio: auto;
      height: 100%;
      min-height: 480px;
    }
  }
</style>
