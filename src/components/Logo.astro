---
import { Image } from 'astro:assets';
import mark from '~/assets/logo-mark.png';
import word from '~/assets/logo-type.png';
import motto_ from '~/assets/logo-motto.png';
import lockup from '~/assets/logo-lockup.png';

/**
 * Marca Stratux (logo nova, 26/11/2026).
 * S, nome e frase vêm recortados da arte enviada pelo cliente
 * (single source: src/assets/logo-*.png, fundo transparente).
 *
 * TODO cliente: solicitar o arquivo vetorial (SVG/AI) para substituir o PNG.
 */
interface Props {
  variant?: 'full' | 'mark' | 'lockup';
  size?: number;
  motto?: boolean;
  class?: string;
  eager?: boolean;
  title?: string;
}
const {
  variant = 'full',
  size = 44,
  motto = false,
  class: cls = '',
  eager = false,
  title = 'Stratux Consultoria Empresarial',
} = Astro.props;
const ratio = mark.width / mark.height;
const mw = (k: number) => Math.round(size * ratio * k);
const wh = size * 0.42; // altura do nome ao lado do S
const ww = (k: number) => Math.round(wh * (word.width / word.height) * k);
---

{
  variant === 'lockup' ? (
    <Image
      src={lockup}
      alt={title}
      widths={[360, 540, 720, 843]}
      sizes="(max-width: 700px) 78vw, 520px"
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class={`logo-lockup ${cls}`}
      densities={undefined}
    />
  ) : (
    <span class={`logo logo--${variant} ${cls}`} style={`--mk:${size}px;--mr:${ratio}`}>
      <Image
        src={mark}
        alt={variant === 'mark' ? title : ''}
        width={mw(1)}
        height={size}
        widths={[mw(1), mw(2), mw(3)]}
        sizes={`${mw(1)}px`}
        formats={['avif', 'webp']}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        class="logo__mark"
        aria-hidden={variant === 'mark' ? undefined : 'true'}
      />
      {variant === 'full' && (
        <span class="logo__type">
          <Image
            src={word}
            alt="Stratux"
            width={ww(1)}
            height={Math.round(wh)}
            widths={[ww(1), ww(2), ww(3)]}
            sizes={`${ww(1)}px`}
            formats={['avif', 'webp']}
            loading={eager ? 'eager' : 'lazy'}
            class="logo__word"
          />
          {motto && (
            <Image
              src={motto_}
              alt="Estratégia · Gestão · Resultados"
              widths={[ww(1), ww(2), ww(3)]}
              sizes={`${ww(1)}px`}
              formats={['avif', 'webp']}
              loading={eager ? 'eager' : 'lazy'}
              class="logo__motto"
            />
          )}
        </span>
      )}
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--mk) * 0.3);
    line-height: 1;
  }
  .logo__mark {
    flex: none;
    display: block;
    width: calc(var(--mk) * var(--mr));
    height: var(--mk);
    object-fit: contain;
  }
  .logo__type {
    display: grid;
    justify-items: start;
    gap: calc(var(--mk) * 0.16);
  }
  .logo__word {
    display: block;
    height: calc(var(--mk) * 0.42);
    width: auto;
  }
  .logo__motto {
    display: block;
    width: calc(var(--mk) * 0.42 * 835 / 120);
    height: auto;
  }

  .logo-lockup {
    width: min(78vw, 520px);
    height: auto;
    margin-inline: auto;
  }
</style>
