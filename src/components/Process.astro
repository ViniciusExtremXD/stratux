---
import Icon from '~/components/Icon.astro';
import { processSteps, faq, wa } from '~/data/site';

/**
 * Como trabalhamos — linha do tempo que se desenha na entrada da seção.
 * Horizontal no desktop, vertical no mobile. A linha é um elemento real
 * animado por scaleX/scaleY; sem JavaScript ela nasce desenhada por inteiro.
 *
 * O texto sobre migração de contador é o mesmo do FAQ — fonte única em site.ts.
 */
const migracao = faq.find((f) => f.q.startsWith('Trocar de contador'));

const waMigracao = wa(
  'Olá! Vim pelo site da Stratux, na seção Como trabalhamos. Já tenho contador e quero entender como funciona a migração.',
);
---

<section class="proc section" id="processo" aria-labelledby="processo-h">
  <div class="shell">
    <div class="sechead">
      <p class="kicker" data-reveal="fade">Como trabalhamos</p>
      <h2 class="h2" id="processo-h" data-split>
        Quatro etapas, do diagnóstico ao relatório que serve para decidir.
      </h2>
      <p class="lead" data-reveal style="--i:1">
        Nenhuma proposta antes de olhar a sua situação real. Depois disso, o calendário é nosso: a
        rotina roda com aviso antes de cada vencimento e fecha com uma leitura do mês.
      </p>
    </div>

    <div class="proc__track" data-reveal="timeline">
      <div class="proc__rail" aria-hidden="true">
        <span class="proc__line"></span>
      </div>

      <ol class="proc__steps">
        {
          processSteps.map((step, i) => (
            <li class="proc__step" style={`--i:${i}`}>
              <span class="proc__node" aria-hidden="true" />
              <div class="proc__head">
                <span class="proc__n num" aria-hidden="true">
                  {step.n}
                </span>
                <span class="icobox proc__ico">
                  <Icon name={step.icon} size={21} />
                </span>
              </div>
              <h3 class="h4 proc__title">{step.title}</h3>
              <p class="proc__text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    {
      migracao && (
        <aside class="proc__migra card on-navy" data-reveal aria-labelledby="processo-migra-h">
          <div class="proc__migrahead">
            <span class="icobox">
              <Icon name="transfer" size={21} />
            </span>
            <span class="badge badge--gold">Troca de escritório</span>
          </div>

          <div class="proc__migracopy">
            <h3 class="h3 proc__migratitle" id="processo-migra-h">
              {migracao.q}
            </h3>
            <p class="proc__migratext">{migracao.a}</p>
          </div>

          <a class="btn btn--gold proc__migracta" href={waMigracao} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={17} class="btn__ico" />
            <span>Falar sobre a migração</span>
          </a>
        </aside>
      )
    }
  </div>
</section>

<style>
  .proc {
    background: var(--bg-raised);
    border-block: 1px solid var(--line);
  }

  /* ---------- trilho ---------- */
  .proc__track {
    --dot: 14px;
    position: relative;
  }

  .proc__rail {
    position: absolute;
    top: 0.45rem;
    bottom: 2rem;
    left: calc(var(--dot) / 2 - 1px);
    width: 2px;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(194, 203, 212, 0.35) 0%,
      rgba(194, 203, 212, 0.35) 85%,
      transparent 100%
    );
    border-radius: var(--r-pill);
  }
  .proc__line {
    position: absolute;
    inset: 0;
    border-radius: var(--r-pill);
    background: linear-gradient(
      180deg,
      var(--gold-400) 0%,
      var(--accent-fill) 80%,
      transparent 100%
    );
    box-shadow: 0 0 10px rgba(201, 162, 39, 0.45);
    transform-origin: 50% 0;
    will-change: transform;
  }

  .proc__line::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 10px 2px rgba(247, 234, 196, 0.9),
      0 0 18px 4px rgba(201, 162, 39, 0.7);
    transform: translate(-50%, 50%);
    pointer-events: none;
    opacity: 0;
  }

  /* ---------- etapas ---------- */
  .proc__steps {
    display: grid;
    gap: var(--s-7);
  }
  .proc__step {
    position: relative;
    padding-left: calc(var(--dot) + var(--s-5));
  }
  .proc__node {
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--accent-fill);
    box-shadow: 0 0 0 4px var(--bg-raised), 0 0 8px rgba(201, 162, 39, 0.25);
    transform-origin: center center;
  }

  .proc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-4);
  }
  .proc__n {
    font-size: clamp(1.95rem, 1.45rem + 1.5vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--accent);
    transform-origin: left bottom;
  }
  .proc__ico {
    transition:
      border-color var(--d-2) var(--e-out),
      background var(--d-2) var(--e-out),
      transform var(--d-2) var(--e-out);
    transform-origin: center center;
  }

  .proc__step:hover .proc__ico {
    transition-delay: 0s !important;
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-2px) scale(1.05);
  }
  .proc__step:hover .proc__node {
    transform: scale(1.3) !important;
    box-shadow: 0 0 0 4px var(--bg-raised), 0 0 18px var(--accent-fill) !important;
    transition: transform 0.25s var(--e-out), box-shadow 0.25s var(--e-out) !important;
  }
  .proc__step:hover .proc__n {
    transition-delay: 0s !important;
    color: var(--gold-600);
  }

  .proc__title {
    margin-bottom: var(--s-2);
  }
  .proc__text {
    max-width: 58ch;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--fg-mute);
  }

  /* ---------- migração de contador ---------- */
  .proc__migra {
    display: grid;
    gap: var(--s-5);
    margin-top: clamp(2.75rem, 1.8rem + 3vw, 4.5rem);
    padding: clamp(1.5rem, 1rem + 1.8vw, 2.5rem);
    box-shadow: var(--sh-3);
    align-items: start;
  }
  .proc__migrahead {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .proc__migracopy {
    display: grid;
    gap: var(--s-3);
  }
  .proc__migratitle {
    max-width: 24ch;
  }
  .proc__migratext {
    max-width: 62ch;
  }
  .proc__migracta {
    justify-self: start;
    max-width: 100%;
  }

  /* ---------- desktop: linha do tempo horizontal ---------- */
  @media (min-width: 900px) {
    .proc__rail {
      top: calc(var(--dot) / 2 - 1px);
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 2px;
      background: linear-gradient(
        90deg,
        rgba(194, 203, 212, 0.35) 0%,
        rgba(194, 203, 212, 0.35) 75%,
        transparent 100%
      );
    }
    .proc__line {
      background: linear-gradient(
        90deg,
        var(--gold-400) 0%,
        var(--accent-fill) 75%,
        transparent 100%
      );
      transform-origin: 0 50%;
    }
    .proc__line::after {
      bottom: auto;
      right: 0;
      top: 50%;
      left: auto;
      transform: translate(50%, -50%);
    }
    .proc__steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-5);
      align-items: start;
    }
    .proc__step {
      padding-left: 0;
      padding-top: calc(var(--dot) + var(--s-5));
      padding-right: var(--s-4);
    }
    .proc__node {
      top: 0;
    }
    .proc__head {
      justify-content: flex-start;
      gap: var(--s-4);
    }

    .proc__migra {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: var(--s-6);
      align-items: center;
    }
    .proc__migrahead {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-3);
    }
  }

  /* ---------- Animação orquestrada da linha do tempo ---------- */
  :global(html.js) .proc__track[data-reveal="timeline"] {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  /* Estado inicial com JS ativo (antes da revelação) */
  :global(html.js) .proc__line {
    transform: scaleY(0);
    transition: transform 1.55s cubic-bezier(0.22, 1, 0.36, 1) 0.05s;
  }
  @media (min-width: 900px) {
    :global(html.js) .proc__line {
      transform: scaleX(0);
    }
  }

  :global(html.js) .proc__line::after {
    opacity: 0;
  }

  :global(html.js) .proc__node {
    transform: scale(0);
    opacity: 0;
  }

  :global(html.js) .proc__n {
    opacity: 0;
    transform: translateY(18px) scale(0.94);
  }

  :global(html.js) .proc__ico {
    opacity: 0;
    transform: translateY(16px) scale(0.88);
  }

  :global(html.js) .proc__title {
    opacity: 0;
    transform: translateY(14px);
  }

  :global(html.js) .proc__text {
    opacity: 0;
    transform: translateY(14px);
  }

  /* Estado revelado: .proc__track.is-in */
  :global(html.js) .proc__track.is-in .proc__line {
    transform: scaleY(1);
  }
  @media (min-width: 900px) {
    :global(html.js) .proc__track.is-in .proc__line {
      transform: scaleX(1);
    }
  }

  :global(html.js) .proc__track.is-in .proc__line::after {
    opacity: 1;
    transition: opacity 0.4s ease-out 1.5s;
  }
  :global(html.js) .proc__track.is-in .proc__line.is-settled::after {
    opacity: 0;
  }

  :global(html.js) .proc__track.is-in .proc__node {
    animation: procNodePop 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 0.38s + 0.08s) both;
  }

  :global(html.js) .proc__track.is-in .proc__n {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 0.55s var(--e-out),
      transform 0.55s var(--e-out);
    transition-delay: calc(var(--i) * 0.38s + 0.18s);
  }

  :global(html.js) .proc__track.is-in .proc__ico {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 0.55s var(--e-out),
      transform 0.55s var(--e-out),
      border-color var(--d-2) var(--e-out),
      background var(--d-2) var(--e-out);
    transition-delay: calc(var(--i) * 0.38s + 0.24s);
  }

  :global(html.js) .proc__track.is-in .proc__title {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.55s var(--e-out),
      transform 0.55s var(--e-out);
    transition-delay: calc(var(--i) * 0.38s + 0.30s);
  }

  :global(html.js) .proc__track.is-in .proc__text {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.6s var(--e-out),
      transform 0.6s var(--e-out);
    transition-delay: calc(var(--i) * 0.38s + 0.36s);
  }

  @keyframes procNodePop {
    0% {
      transform: scale(0);
      opacity: 0;
      box-shadow: 0 0 0 0 rgba(201, 162, 39, 0.9);
    }
    45% {
      transform: scale(1.42);
      opacity: 1;
      box-shadow: 0 0 0 8px rgba(201, 162, 39, 0.35), 0 0 16px rgba(201, 162, 39, 0.6);
    }
    70% {
      transform: scale(0.94);
      box-shadow: 0 0 0 4px var(--bg-raised), 0 0 10px rgba(201, 162, 39, 0.4);
    }
    100% {
      transform: scale(1);
      opacity: 1;
      box-shadow: 0 0 0 4px var(--bg-raised), 0 0 8px rgba(201, 162, 39, 0.25);
    }
  }

  /* Redes de segurança — acessibilidade e fallback de falha */
  :global(html.motion-failed) .proc__line,
  :global(html.motion-reduced) .proc__line,
  :global(html.motion-failed) .proc__node,
  :global(html.motion-reduced) .proc__node,
  :global(html.motion-failed) .proc__n,
  :global(html.motion-reduced) .proc__n,
  :global(html.motion-failed) .proc__ico,
  :global(html.motion-reduced) .proc__ico,
  :global(html.motion-failed) .proc__title,
  :global(html.motion-reduced) .proc__title,
  :global(html.motion-failed) .proc__text,
  :global(html.motion-reduced) .proc__text {
    opacity: 1 !important;
    transform: none !important;
    animation: none !important;
    transition: none !important;
  }
  :global(html.motion-failed) .proc__line::after,
  :global(html.motion-reduced) .proc__line::after,
  :global(html:not(.js)) .proc__line::after {
    display: none !important;
  }
</style>
